+    """Decode standard JSON escapes while preserving unescaped model text."""
+    escapes = {
+        '"': '"', '\\': '\\', '/': '/', 'b': '\b', 'f': '\f',
+        'n': '\n', 'r': '\r', 't': '\t',
+    }
+    out: list[str] = []
+    index = 0
+    while index < len(value):
+        char = value[index]
+        if char != "\\" or index + 1 >= len(value):
+            out.append(char)
+            index += 1
+            continue
+        marker = value[index + 1]
+        if marker == "u" and index + 5 < len(value):
+            digits = value[index + 2:index + 6]
