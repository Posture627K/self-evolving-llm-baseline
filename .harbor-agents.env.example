# Configure exactly one provider route. Never commit the populated file.

# DeepSeek preset uses Claude Code in the container and LiteLLM on the host.
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_API_KEY=

# GPT/Codex presets in this repository use Azure OpenAI.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_API_VERSION=

# Direct Anthropic Claude preset.
ANTHROPIC_API_KEY=

# Default Claude presets use AWS Bedrock.
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-1
CLAUDE_CODE_USE_BEDROCK=1

# Gemini presets use the direct Gemini API.
GEMINI_API_KEY=

# Kimi presets use an OpenAI-compatible endpoint.
KIMI_BEDROCK_BASE_URL=
KIMI_BEDROCK_API_KEY=
